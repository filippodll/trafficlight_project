{
    "version": 2,
    "configurePresets": [
      {
        "name": "release",
        "inherits": "vcpkg",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release"
        },
        "environment": {
          "VCPKG_ROOT": "../vcpkg"
        }
      },
      {
        "name": "debug",
        "inherits": "vcpkg",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug"
        },
        "environment": {
          "VCPKG_ROOT": "../vcpkg"
        }
      }
    ]
  }